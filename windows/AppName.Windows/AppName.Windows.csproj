<Project Sdk="Microsoft.NET.Sdk">

  <!-- The ONLY project in the solution on a Windows TFM, and the only one that may
       touch WinRT (Windows.Services.Store, toasts via WinRT, etc.). It exists because
       WinRT APIs need `net10.0-windows10.0.x`, and putting that TFM on AppName.App
       breaks every Windows publish with MSB4062 (ExpandPriContent) — a task that
       ships with Visual Studio and not the dotnet CLI.

       The trap is content-shaped, which is why this project can carry the TFM safely:
       the Windows TFM turns on MSBuild's Appx/PRI indexing over @(Content), and
       AppName.App links shared assets as Content. A class library with NO content
       items never runs that task. KEEP IT CONTENT-FREE — do not add Content here.

       AppName.App does NOT ProjectReference this (a net10.0 app cannot reference a
       net10.0-windows library). The MSIX publish drops the output next to the app
       and the app loads it reflectively (Assembly.LoadFrom), degrading to an inert
       implementation when the assembly is absent — sideload and dev builds keep
       working. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Must match AppxManifest.xml's TargetDeviceFamily MinVersion, or CA1416 stays
         quiet about an API that does not exist on the oldest Windows 10 the Store
         will install this on. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- The Windows TFM defaults RuntimeIdentifiers to the UWP-era win10-* RIDs that
         .NET 5 deleted, which fails restore with NETSDK1083. Name the one RID we
         ship. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Compile the WinRT edge on the Mac head too (NETSDK1100 without it). The SDK
         ref pack is a NuGet download, so this only needs to RESOLVE cross-platform —
         it never runs here. CI is the gate, but a compile error is worth catching in
         seconds rather than in a 4-minute windows-latest round trip. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Belt and braces: never let the Appx/PRI targets consider this project. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppName.Core\AppName.Core.csproj" />
  </ItemGroup>

</Project>
