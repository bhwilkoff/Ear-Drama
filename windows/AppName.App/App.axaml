<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AppName.App.App"
             xmlns:local="using:AppName.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light/dark; FluentAvaloniaTheme gives the WinUI 11 look. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Design tokens: change design-tokens.json at the repository root and run
             `node tools/design_tokens.mjs`; every platform follows. Light and Dark
             follow the system theme. -->
        <ResourceDictionary>
            <!-- BEGIN design-tokens:resources. Generated from design-tokens.json by tools/design_tokens.mjs. Do not edit by hand. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BrandPrimary">#B0152F</Color>
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#B0152F"/>
                    <Color x:Key="BrandOnPrimary">#FFFFFF</Color>
                    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="#FFFFFF"/>
                    <Color x:Key="BrandBackground">#FFFFFF</Color>
                    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#FFFFFF"/>
                    <Color x:Key="BrandSurface">#F4F4F5</Color>
                    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#F4F4F5"/>
                    <Color x:Key="BrandSurfaceAlt">#E8E8EB</Color>
                    <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#E8E8EB"/>
                    <Color x:Key="BrandText">#131316</Color>
                    <SolidColorBrush x:Key="BrandTextBrush" Color="#131316"/>
                    <Color x:Key="BrandTextMuted">#5C5C66</Color>
                    <SolidColorBrush x:Key="BrandTextMutedBrush" Color="#5C5C66"/>
                    <Color x:Key="BrandBorder">#D8D8DD</Color>
                    <SolidColorBrush x:Key="BrandBorderBrush" Color="#D8D8DD"/>
                    <Color x:Key="BrandSecondary">#0B6E99</Color>
                    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#0B6E99"/>
                    <Color x:Key="BrandOnSecondary">#FFFFFF</Color>
                    <SolidColorBrush x:Key="BrandOnSecondaryBrush" Color="#FFFFFF"/>
                    <Color x:Key="BrandLink">#0B6E99</Color>
                    <SolidColorBrush x:Key="BrandLinkBrush" Color="#0B6E99"/>
                    <Color x:Key="SemanticSuccess">#1D7A4A</Color>
                    <SolidColorBrush x:Key="SemanticSuccessBrush" Color="#1D7A4A"/>
                    <Color x:Key="SemanticWarning">#8A5300</Color>
                    <SolidColorBrush x:Key="SemanticWarningBrush" Color="#8A5300"/>
                    <Color x:Key="SemanticError">#C2410C</Color>
                    <SolidColorBrush x:Key="SemanticErrorBrush" Color="#C2410C"/>
                    <Color x:Key="SemanticErrorSurface">#FDEEE8</Color>
                    <SolidColorBrush x:Key="SemanticErrorSurfaceBrush" Color="#FDEEE8"/>
                    <Color x:Key="GenreDrama">#B42575</Color>
                    <SolidColorBrush x:Key="GenreDramaBrush" Color="#B42575"/>
                    <Color x:Key="GenreMystery">#3753A2</Color>
                    <SolidColorBrush x:Key="GenreMysteryBrush" Color="#3753A2"/>
                    <Color x:Key="GenreScifi">#03838C</Color>
                    <SolidColorBrush x:Key="GenreScifiBrush" Color="#03838C"/>
                    <Color x:Key="GenreWestern">#A06841</Color>
                    <SolidColorBrush x:Key="GenreWesternBrush" Color="#A06841"/>
                    <Color x:Key="GenreComedy">#8D8300</Color>
                    <SolidColorBrush x:Key="GenreComedyBrush" Color="#8D8300"/>
                    <Color x:Key="GenreNews">#44420E</Color>
                    <SolidColorBrush x:Key="GenreNewsBrush" Color="#44420E"/>
                    <Color x:Key="GenreDocumentary">#217500</Color>
                    <SolidColorBrush x:Key="GenreDocumentaryBrush" Color="#217500"/>
                    <Color x:Key="GenreSerial">#5D0087</Color>
                    <SolidColorBrush x:Key="GenreSerialBrush" Color="#5D0087"/>
                    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#9E132A"/>
                    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#8D1126"/>
                    <SolidColorBrush x:Key="BrandPrimaryDisabledBrush" Color="#66B0152F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BrandPrimary">#E3384B</Color>
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#E3384B"/>
                    <Color x:Key="BrandOnPrimary">#120708</Color>
                    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="#120708"/>
                    <Color x:Key="BrandBackground">#0F0F11</Color>
                    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#0F0F11"/>
                    <Color x:Key="BrandSurface">#19191C</Color>
                    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#19191C"/>
                    <Color x:Key="BrandSurfaceAlt">#232327</Color>
                    <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#232327"/>
                    <Color x:Key="BrandText">#F2F2F4</Color>
                    <SolidColorBrush x:Key="BrandTextBrush" Color="#F2F2F4"/>
                    <Color x:Key="BrandTextMuted">#C4C4CC</Color>
                    <SolidColorBrush x:Key="BrandTextMutedBrush" Color="#C4C4CC"/>
                    <Color x:Key="BrandBorder">#34343A</Color>
                    <SolidColorBrush x:Key="BrandBorderBrush" Color="#34343A"/>
                    <Color x:Key="BrandSecondary">#5AB4D6</Color>
                    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#5AB4D6"/>
                    <Color x:Key="BrandOnSecondary">#06141B</Color>
                    <SolidColorBrush x:Key="BrandOnSecondaryBrush" Color="#06141B"/>
                    <Color x:Key="BrandLink">#6CC0E0</Color>
                    <SolidColorBrush x:Key="BrandLinkBrush" Color="#6CC0E0"/>
                    <Color x:Key="SemanticSuccess">#5CC593</Color>
                    <SolidColorBrush x:Key="SemanticSuccessBrush" Color="#5CC593"/>
                    <Color x:Key="SemanticWarning">#E8B04B</Color>
                    <SolidColorBrush x:Key="SemanticWarningBrush" Color="#E8B04B"/>
                    <Color x:Key="SemanticError">#FF9466</Color>
                    <SolidColorBrush x:Key="SemanticErrorBrush" Color="#FF9466"/>
                    <Color x:Key="SemanticErrorSurface">#3A1F16</Color>
                    <SolidColorBrush x:Key="SemanticErrorSurfaceBrush" Color="#3A1F16"/>
                    <Color x:Key="GenreDrama">#FF91C3</Color>
                    <SolidColorBrush x:Key="GenreDramaBrush" Color="#FF91C3"/>
                    <Color x:Key="GenreMystery">#8DACFA</Color>
                    <SolidColorBrush x:Key="GenreMysteryBrush" Color="#8DACFA"/>
                    <Color x:Key="GenreScifi">#16E3F2</Color>
                    <SolidColorBrush x:Key="GenreScifiBrush" Color="#16E3F2"/>
                    <Color x:Key="GenreWestern">#D97E37</Color>
                    <SolidColorBrush x:Key="GenreWesternBrush" Color="#D97E37"/>
                    <Color x:Key="GenreComedy">#E2D32B</Color>
                    <SolidColorBrush x:Key="GenreComedyBrush" Color="#E2D32B"/>
                    <Color x:Key="GenreNews">#CECEC0</Color>
                    <SolidColorBrush x:Key="GenreNewsBrush" Color="#CECEC0"/>
                    <Color x:Key="GenreDocumentary">#81CB70</Color>
                    <SolidColorBrush x:Key="GenreDocumentaryBrush" Color="#81CB70"/>
                    <Color x:Key="GenreSerial">#AE6DDC</Color>
                    <SolidColorBrush x:Key="GenreSerialBrush" Color="#AE6DDC"/>
                    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#CC3244"/>
                    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#B62D3C"/>
                    <SolidColorBrush x:Key="BrandPrimaryDisabledBrush" Color="#66E3384B"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="Space1">4</x:Double>
            <x:Double x:Key="Space2">8</x:Double>
            <x:Double x:Key="Space3">12</x:Double>
            <x:Double x:Key="Space4">16</x:Double>
            <x:Double x:Key="Space6">24</x:Double>
            <x:Double x:Key="Space8">32</x:Double>
            <CornerRadius x:Key="RadiusControl">8</CornerRadius>
            <CornerRadius x:Key="RadiusCard">12</CornerRadius>
            <!-- END design-tokens:resources -->
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- The brand accent (instead of the default purple) and the type ramp. -->
        <!-- BEGIN design-tokens:styles. Generated from design-tokens.json by tools/design_tokens.mjs. Do not edit by hand. -->
        <sty:FluentAvaloniaTheme CustomAccentColor="#B0152F" />

        <!-- The six-level type ramp, adopted via Classes. Refuse a seventh level. -->
        <Style Selector="TextBlock.view-heading"> <!-- L1 pageTitle -->
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.section-header"> <!-- L2 sectionHeader -->
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.body-strong"> <!-- L3 bodyStrong -->
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.body"> <!-- L4 body -->
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.caption"> <!-- L5 caption -->
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandTextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.tabular"> <!-- L6 tabular -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace"/>
        </Style>
        <!-- END design-tokens:styles -->

        <!-- Reusable design-token styles — one definition, many views. Adopt via
             Classes="card" etc.; never restyle at a call site. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
            <Setter Property="Padding" Value="20"/>
            <!-- The card owns its elevation shadow — never hand-add shadow padding at
                 a call site. Kept subtle so it reads native on Fluent. -->
            <Setter Property="BoxShadow" Value="0 1 8 0 #1A000000"/>
        </Style>

        <!-- The brand CTA. FluentAvalonia derives a LIGHTER accent for the dark theme
             (AccentFillColorDefaultBrush -> Light1/2/3), which washes a brand-colored
             hero out while hard-coded brand fills beside it stay saturated — adjacent
             CTAs disagreeing. The brand primary is a token on every platform (one value
             for light, one for dark, from design-tokens.json), so pin it here. Fluent's derived accent still drives focus rings and
             selection, which is the correct native behaviour for those. -->
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryPressedBrush}"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryDisabledBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
        </Style>
        <!-- Same rule, different control: a switched-on ToggleSwitch is an accent
             surface too. Pin the "on" fill in both themes. -->
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.chunky">
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        </Style>

    </Application.Styles>
</Application>
