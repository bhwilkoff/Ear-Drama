      "after": {"revision": "r1", "lines": [{"id": "L0001", "kind": "speech", "role": "GRACE", "parts": [{"say": "Never mind why. I love you."}]}]},
      "mark": {"line": "L0001", "start": 16, "end": 26, "kind": "highlight"},
      "want": ["L0001", 16, 26]
    },
    {
      "name": "words added before the mark in its line: the mark moves with its words",
      "before": {"revision": "r1", "lines": [{"id": "L0001", "kind": "speech", "role": "A", "parts": [{"say": "I love you."}]}]},
      "after": {"revision": "r2", "lines": [{"id": "L0001", "kind": "speech", "role": "A", "parts": [{"say": "Oh, Grace. I love you."}]}]},
      "mark": {"line": "L0001", "start": 2, "end": 6, "kind": "underline"},
      "want": ["L0001", 13, 17]
    },
    {
      "name": "a run-in speech split out (L0009 to L0009 and L0009a): the mark follows its words to the new id",
      "before": {"revision": "r1", "lines": [
        {"id": "L0008", "kind": "speech", "role": "GRACE", "parts": [{"say": "Why?"}]},
        {"id": "L0009", "kind": "speech", "role": "CHARTERIS", "parts": [{"say": "Of course. Why not?\nGRACE"}, {"direction": "reflecting"}, {"say": ". Never mind why. I love you."}]},
        {"id": "L0010", "kind": "speech", "role": "CHARTERIS", "parts": [{"say": "Never mind why."}]}
      ]},
      "after": {"revision": "r2", "lines": [
        {"id": "L0008", "kind": "speech", "role": "GRACE", "parts": [{"say": "Why?"}]},
        {"id": "L0009", "kind": "speech", "role": "CHARTERIS", "parts": [{"say": "Of course. Why not?"}]},
        {"id": "L0009a", "kind": "speech", "role": "GRACE", "parts": [{"direction": "reflecting"}, {"say": "Never mind why. I love you."}]},
        {"id": "L0010", "kind": "speech", "role": "CHARTERIS", "parts": [{"say": "Never mind why."}]}
      ]},
      "mark": {"line": "L0009", "start": 39, "end": 53, "kind": "highlight"},
      "want": ["L0009a", 11, 25]
