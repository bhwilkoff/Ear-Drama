      "after": {"revision": "r2", "lines": [{"id": "L0001", "kind": "speech", "role": "A", "parts": [{"say": "No, no, I said no to him."}]}]},
      "mark": {"line": "L0001", "start": 11, "end": 13, "kind": "underline"},
