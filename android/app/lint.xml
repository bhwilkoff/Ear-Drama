<?xml version="1.0" encoding="utf-8"?>
<!-- Per-issue, per-path suppressions only; each says why. Never a whole category. -->
<lint>
    <!-- The voice-search feature ("play X Minus One") is the owner's call to build. -->
    <issue id="MissingIntentFilterForMediaSearch">
        <ignore path="src/main/AndroidManifest.xml" />
        <!-- owner call pending (LOOP-PLAN P9) -->
    </issue>

    <!-- Media3 session service: controllers (Android Auto, Assistant, the system) bind to it, so it must be exported. -->
    <issue id="ExportedService">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>

    <!-- androidx.mediarouter's MediaTransferReceiver: the system output switcher sends to it, so it must be exported. -->
    <issue id="ExportedReceiver">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>

    <!-- Generated by tools/design_tokens.mjs from design-tokens.json: the palette mirrors every token whether or not Android reads it yet (Compose Theme.kt carries the colors). -->
    <issue id="UnusedResources">
        <ignore path="src/main/res/values/colors.xml" />
        <ignore path="src/main/res/values-night/colors.xml" />
    </issue>

    <!-- The Android TV banner is one xhdpi asset (320x180), the size the platform asks for. -->
    <issue id="IconMissingDensityFolder">
        <ignore path="src/main/res" />
    </issue>

    <!-- Dependency freshness is a monthly bump (libs.versions.toml header), not a build gate. Held back: alpha pins, and anything not yet two weeks stable. -->
    <issue id="GradleDependency">
        <ignore path="../gradle/libs.versions.toml" />
    </issue>
    <issue id="NewerVersionAvailable">
        <ignore path="../gradle/libs.versions.toml" />
    </issue>
    <issue id="AndroidGradlePluginVersion">
        <ignore path="../gradle/libs.versions.toml" />
        <ignore path="../gradle/wrapper/gradle-wrapper.properties" />
    </issue>

    <!-- targetSdk 36 is held until Android 17 ships and Play forces it (build.gradle.kts note); raising it changes runtime behavior and needs a device pass. -->
    <issue id="OldTargetApi">
        <ignore path="build.gradle.kts" />
    </issue>
</lint>
