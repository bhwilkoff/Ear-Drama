<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Downloaded episodes: re-downloadable, and they never leave the device. -->
    <exclude domain="file" path="downloads/"/>
    <!-- Script marks: private to this device until the sync phase (PLAYS-DESIGN §2.10 rule 11). -->
    <exclude domain="database" path="marks.db"/>
    <exclude domain="database" path="marks.db-wal"/>
    <exclude domain="database" path="marks.db-shm"/>
    <exclude domain="database" path="marks.db-journal"/>
</full-backup-content>
