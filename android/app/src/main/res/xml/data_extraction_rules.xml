<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces fullBackupContent with this. Mirror the
     same exclusion list as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/"/>
        <exclude domain="database" path="marks.db"/>
        <exclude domain="database" path="marks.db-wal"/>
        <exclude domain="database" path="marks.db-shm"/>
        <exclude domain="database" path="marks.db-journal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/"/>
        <exclude domain="database" path="marks.db"/>
        <exclude domain="database" path="marks.db-wal"/>
        <exclude domain="database" path="marks.db-shm"/>
        <exclude domain="database" path="marks.db-journal"/>
    </device-transfer>
</data-extraction-rules>
