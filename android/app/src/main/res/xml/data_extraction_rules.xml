<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces fullBackupContent with this. Mirror the
     same exclusion list as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/"/>
    </device-transfer>
</data-extraction-rules>
